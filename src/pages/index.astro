---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Theme from "../components/Theme.astro";
import Story from "../components/Story.astro";
import Cast from "../components/Cast.astro";
import EventInfo from "../components/EventInfo.astro";
import Ticket from "../components/Ticket.astro";
import Notices from "../components/Notices.astro";
import Access from "../components/Access.astro";
import Footer from "../components/Footer.astro";
import StoryText from "../components/items/storyText.astro"
import Frame from "../components/items/Frame.astro"
import StoryButton from "../components/items/storyButton.astro"
import PageButton from "../components/items/pageButton.astro";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="第26回 和太鼓 早春の陣">
	<Header />
	<Hero />
	<StoryText>
  		四季がなくなってしまった世界
		<br/><br/><br/>
		ある日から雲が空を覆い尽くし、夜が永遠に続くようになりました
	</StoryText>
	<Theme />
	<div class="flex flex-col justify-center items-center gap-4">
  		<StoryButton />
	<PageButton
		href="/cast"
		background="/icon_wind.svg"
		label="出演団体"
		position="right"
	/>
	<PageButton
		href="/info"
		background="/icon_forest.svg"
		label="公演情報"
		disabled={true}
		position="left"
	/>
	<PageButton
		href="/reserve"
		background="/icon_fire.svg"
		label="予約"
		position="right"
		target="_blank"
	/>
	<PageButton
		href="/info"
		background="/icon_mountain.svg"
		label="アクセス"
		disabled={true}
		position="left"
	/>
	</div>
	
	<StoryText>
		日が差すどこかに、春を呼ぶ鈴があるらしい
		<br/><br/><br/>
		旅人らはすっかり冷え込んだ町を出て行き、春を呼ぶ鈴を探しにいきました ───
	</StoryText>
	<Footer />
</MainLayout>