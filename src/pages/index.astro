---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Theme from "../components/Theme.astro";
import Footer from "../components/Footer.astro";
import StoryText from "../components/items/storyText.astro"
import StoryButton from "../components/items/storyButton.astro"
import PageButton from "../components/items/pageButton.astro";
import MainLayout from "../layouts/MainLayout.astro";

const footerImage = "/cloud_img.svg";
---

<MainLayout title="第26回 和太鼓 早春の陣">
	<Header />
	<Hero />
	<img src={footerImage} alt="" class="opacity-30"/>
	<StoryText>
  		四季がなくなってしまった世界
		<br/><br/><br/>
		ある日から雲が空を覆い尽くし、夜が永遠に続くようになりました
	</StoryText>
	<Theme />
	<div class="flex flex-col justify-center items-center gap-4">
  		<StoryButton />
	<PageButton
		href="/cast"
		background="/icon/icon_night.svg"
		label="出演団体"
		position="right"
	/>
	<PageButton
		href="/event"
		background="icon/icon_storm.svg"
		label="公演情報"
		position="left"
	/>
	<PageButton
		href="/reserve"
		background="/icon/icon_flower.svg"
		label="予約"
		position="right"
	/>
	<PageButton
		href="/access"
		background="/icon/icon_wind.svg"
		label="アクセス"
		position="left"
	/>
	</div>
	
	<StoryText>
		日が差すどこかに、春を呼ぶ鈴があるらしい
		<br/><br/><br/>
		旅人らはすっかり冷え込んだ町を出て行き、春を呼ぶ鈴を探しにいきました ───
	</StoryText>
	<Footer />
</MainLayout>