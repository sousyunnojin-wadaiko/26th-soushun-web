---
import OtherLayout from "../layouts/OtherLayout.astro";
import "./SeatReservation.css";

const API_URL = import.meta.env.PUBLIC_GAS_API_URL;

const seatSections = [
  {
    name: "フロア席",
    note: "段差がないためステージが見えにくい可能性があります。",
    rows: ["X", "Y", "Z"],
    className: "floor-section",
  },
  {
    name: "段差席",
    note: "階段がございます。足元にご注意ください。",
    rows: "ABCDEFGHI".split(""),
    className: "riser-section",
  },
];

const floorLayout = {
  X: [4, 6, 3],
  Y: [4, 7, 4],
  Z: [5, 6, 4]
};
const riserLayout = [4, 9, 4];

const cameraSeats = new Set([
  "H-8", "H-9", "H-10",
  "I-8", "I-9", "I-10",
]);
---

<OtherLayout
  title="席予約 | 第26回 和太鼓 早春の陣"
  pageTitle="席予約"
  bg="fire"
>

  <!-- 予約人数とlegend -->
  <div id="reservation-header-info" class="reservation-header-right" hidden>
    <div class="reservation-count">
      <span>予約人数</span>
      <strong id="allowed-seats">0</strong>
      <span>名</span>
    </div>
    
    <div class="legend">
      <span><i class="available-color"></i>空席</span>
      <span><i class="selected-color"></i>選択中</span>
      <span><i class="reserved-color"></i>予約済み</span>
      <span><i class="mine-color"></i>自分の席</span>
      <span><i class="camera-color"></i>撮影専用</span>
    </div>
  </div>

  <div id="reservation-login" class="reservation-login">
    <section class="reservation-step">
      <div class="reservation-step-heading">
        <span class="reservation-step-number">STEP 1</span>
        <h3>予約フォームに回答</h3>
      </div>

      <p class="reservation-step-description">
        はじめに、予約フォームから必要事項をご入力ください。
      </p>

      <a
        href="https://forms.gle/dAKW4USFRwheYtAE7"
        class="reservation-form-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        予約フォームを開く
      </a>
    </section>

    <div class="reservation-step-divider">
      <span>↓</span>
    </div>

    <section class="reservation-step">
      <div class="reservation-step-heading">
        <span class="reservation-step-number">STEP 2</span>
        <h3>予約IDを入力</h3>
      </div>

      <p class="reservation-step-description">
        予約IDは、お申し込み時にご入力いただいたメールアドレス宛にお送りしております。
      </p>

      <div id="id-form" class="id-form">
        <input id="reservation-id" type="text" placeholder="予約ID" />
        <button id="check-button">確認</button>
      </div>
    </section>
  </div>

  <div id="loading" class="loading-overlay" hidden>
    <div class="loading-box">
      <p>少々お待ちください… ⏳</p>
    </div>
  </div>

  <div id="reservation-content" hidden>
    <div class="reservation-status">
      <p id="selection-info">座席を選択してください</p>
    </div>

    <div id="seat-minimap-container" class="seat-minimap-container" hidden>
      <div class="seat-minimap-header">
        <span>座席全体図</span>
        <span class="seat-minimap-guide">枠をタップして移動できます</span>
      </div>

      <div id="seat-minimap" class="seat-minimap" aria-label="座席表の表示位置を移動">
        <div id="seat-minimap-content" class="seat-minimap-content" aria-hidden="true"></div>
        <div class="seat-minimap-shade seat-minimap-shade-left"></div>
        <div class="seat-minimap-shade seat-minimap-shade-right"></div>
        <div class="seat-minimap-viewport"></div>
      </div>
      <p class="seat-minimap-caption">
        明るい範囲が現在表示されいている座席です
      </p>
    </div>

    <div class="theater" id="seat-theater">
      <div class="seat-area">
        <div class="stage">STAGE</div>

        <div class="seat-map">
          {seatSections.map((section) => (
            <section class={`seat-section ${section.className}`}>
              <div class="seat-section-title">
                <h3>{section.name}</h3>
                {section.note && <p class="seat-section-note"> ※ {section.note}</p>}
              </div>

              <div class="seat-section-rows">
                {section.rows.map((rowLabel) => {
                  const isFloorRow = ["X", "Y", "Z"].includes(rowLabel);

                  const currentLayout = isFloorRow
                    ? floorLayout[rowLabel as keyof typeof floorLayout]
                    : riserLayout;

                  const totalSeats = currentLayout.reduce(
                    (a, b) => a + b, 0
                  );
                  const center = (totalSeats + 1) / 2;

                  return (
                    <div
                      class={`seat-row ${isFloorRow ? "floor-row" : "riser-row"}`}
                      data-row={rowLabel}
                    >
                      {currentLayout.map((count, blockIndex) => (
                        <>
                          <div
                            class={`seat-block ${
                              isFloorRow && blockIndex === 1
                                ? "floor-center-block"
                                : ""
                            }`}
                          >
                            {Array.from({ length: count }, (_, i) => {
                              const number =
                                currentLayout
                                  .slice(0, blockIndex)
                                  .reduce((a, b) => a + b, 0)
                                + i + 1;

                              const distance = number - center;
                              const seatId = `${rowLabel}-${number}`;
                              const isCameraSeat = cameraSeats.has(seatId);

                              return (
                                <button
                                  type="button"
                                  class={`seat ${isCameraSeat ? "camera-seat" : "available"}`}
                                  data-seat-id={seatId}
                                  aria-label={
                                    isCameraSeat
                                      ? `${seatId} 撮影専用席（予約不可）`
                                      : seatId
                                  }
                                  title={isCameraSeat ? `${seatId} 撮影専用席` : seatId}
                                  disabled={isCameraSeat}
                                  style={
                                    isFloorRow
                                      ? `--distance-squared: ${distance * distance};`
                                      : undefined
                                  }
                                >
                                  {isCameraSeat ? "📷" : seatId}
                                </button>
                              );
                            })}
                          </div>

                          {blockIndex < 2 && <div class="aisle"></div>}
                        </>
                      ))}
                    </div>
                  );
                })}
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>

    <div class="action-area">
      <button id="confirm-button" class="confirm-btn" disabled>
        予約確定
      </button>

      <button id="cancel-button" class="cancel-btn" hidden>
        予約取消
      </button>
    </div>
  </div>

  <section class="seat-reference">
    <h3 class="seat-reference-title">座席配置の参考画像</h3>

    <div class="seat-reference-wrapper">
      <div class="ref-img-container">
        <img
          src="/img_seat.svg"
          alt="会場の座席配置の参考画像"
          class="seat-reference-image"
          loading="lazy"
          draggable="false"
          oncontextmenu="return false;"
        />
      </div>
      <div class="ref-img-container">
        <img
          src="/img_seat_kamite.svg"
          alt="上手側の参考画像"
          class="seat-reference-image"
          loading="lazy"
          draggable="false"
          oncontextmenu="return false;"
        />
      </div>
      <div class="ref-img-container">
        <img
          src="/img_seat_center.svg"
          alt="中央の参考画像"
          class="seat-reference-image"
          loading="lazy"
          draggable="false"
          oncontextmenu="return false;"
        />
      </div>
      <div class="ref-img-container">
        <img
          src="/img_seat_shimote.svg"
          alt="下手側の参考画像"
          class="seat-reference-image"
          loading="lazy"
          draggable="false"
          oncontextmenu="return false;"
        />
      </div>
    </div>
    <p class="seat-reference-notice">
      ※ 画像の無断転載・複製・二次利用はご遠慮ください。
    </p>
  </section>

  <div id="alert" class="alert" hidden>
    <p id="alert-message"></p>
  </div>
</OtherLayout>

<script define:vars={{ API_URL }}>
  const reservationIdInput = document.querySelector("#reservation-id");
  const checkButton = document.querySelector("#check-button");
  const idForm = document.querySelector("#id-form");
  const content = document.querySelector("#reservation-content");
  const headerInfo = document.querySelector("#reservation-header-info");
  const reservationLogin = document.querySelector("#reservation-login");
  const allowedSeatsText = document.querySelector("#allowed-seats");
  const selectionInfo = document.querySelector("#selection-info");

  const loading = document.querySelector("#loading");
  const alertBox = document.querySelector("#alert");
  const alertMessage = document.querySelector("#alert-message");

  const confirmButton = document.querySelector("#confirm-button");
  const cancelButton = document.querySelector("#cancel-button");

  let reservationId = "";
  let allowedSeats = 0;
  let selectedSeats = [];
  let mySeats = [];

  let isVerified = false;
  let mode = "select";
  let isLoading = false;
  let alertTimer;

  const allSeats = [...document.querySelectorAll(".seat")];

  // =========================
  // 座席ミニマップ
  // =========================

  const theater = document.querySelector("#seat-theater");
  const seatArea = theater.querySelector(".seat-area");

  const minimapContainer = document.querySelector(
    "#seat-minimap-container"
  );
  const minimap = document.querySelector("#seat-minimap");
  const minimapContent = document.querySelector(
    "#seat-minimap-content"
  );

  const minimapViewport = document.querySelector(
    ".seat-minimap-viewport"
  );

  const minimapShadeLeft = document.querySelector(
    ".seat-minimap-shade-left"
  );

  const minimapShadeRight = document.querySelector(
    ".seat-minimap-shade-right"
  );

  let minimapScale = 1;
  let minimapPointerId = null;

  // ミニマップ生成
  function initializeMinimap() {
    const clone = seatArea.cloneNode(true);

    // 複製側は表示専用
    clone.querySelectorAll("button").forEach((button) => {
      button.disabled = true;
      button.tabIndex = -1;
    });

    // IDの重複を防ぐ
    clone.querySelectorAll("[id]").forEach((element) => {
      element.removeAttribute("id");
    });

    clone.removeAttribute("id");
    clone.setAttribute("aria-hidden", "true");

    minimapContent.replaceChildren(clone);

    syncMinimapSeats();
    updateMinimapLayout();
  }

  // サイズと表示条件を更新
  function updateMinimapLayout() {
    if (content.hidden) {
      minimapContainer.hidden = true;
      return;
    }

    const needsScroll =
      theater.scrollWidth > theater.clientWidth + 1;

    const isMobile = window.innerWidth <= 768;

    minimapContainer.hidden = !needsScroll || !isMobile;

    if (minimapContainer.hidden) return;

    const mapWidth = minimap.clientWidth;
    const originalWidth = theater.scrollWidth;
    const originalHeight = seatArea.offsetHeight;

    if (!mapWidth || !originalWidth || !originalHeight) return;

    minimapScale = mapWidth / originalWidth;

    minimap.style.height = `${originalHeight * minimapScale}px`;
    minimapContent.style.width = `${originalWidth}px`;
    minimapContent.style.height = `${originalHeight}px`;

    minimapContent.style.transform = `scale(${minimapScale})`;

    updateMinimapViewport();
  }

  // 現在の表示範囲を更新
  function updateMinimapViewport() {
    if (minimapContainer.hidden) return;

    const mapWidth = minimap.clientWidth;

    const left = theater.scrollLeft * minimapScale;
    const width = Math.min(
      theater.clientWidth * minimapScale,
      mapWidth
    );

    const safeLeft = Math.max(
      0,
      Math.min(left, mapWidth - width)
    );

    minimapViewport.style.left = `${safeLeft}px`;
    minimapViewport.style.width = `${width}px`;

    minimapShadeLeft.style.left = "0px";
    minimapShadeLeft.style.width = `${safeLeft}px`;

    minimapShadeRight.style.left =
      `${safeLeft + width}px`;

    minimapShadeRight.style.width =
      `${Math.max(0, mapWidth - safeLeft - width)}px`;
  }

  // ミニマップ上の位置へ移動
  function scrollToMinimapPosition(clientX) {
    if (minimapContainer.hidden) return;

    const rect = minimap.getBoundingClientRect();

    const x = Math.max(
      0,
      Math.min(clientX - rect.left, rect.width)
    );

    const targetScrollLeft =
      x / minimapScale - theater.clientWidth / 2;

    const maxScroll =
      theater.scrollWidth - theater.clientWidth;

    theater.scrollLeft = Math.max(
      0,
      Math.min(targetScrollLeft, maxScroll)
    );

    updateMinimapViewport();
  }

  // 下の座席表をスワイプしたとき
  theater.addEventListener("scroll", () => {
    updateMinimapViewport();
  }, { passive: true });

  // ミニマップをタップ・ドラッグしたとき
  minimap.addEventListener("pointerdown", (event) => {
    if (minimapContainer.hidden) return;

    minimapPointerId = event.pointerId;
    minimap.setPointerCapture(event.pointerId);

    scrollToMinimapPosition(event.clientX);
  });

  minimap.addEventListener("pointermove", (event) => {
    if (event.pointerId !== minimapPointerId) return;

    scrollToMinimapPosition(event.clientX);
  });

  function endMinimapDrag(event) {
    if (event.pointerId !== minimapPointerId) return;

    minimapPointerId = null;

    if (minimap.hasPointerCapture(event.pointerId)) {
      minimap.releasePointerCapture(event.pointerId);
    }
  }

  minimap.addEventListener("pointerup", endMinimapDrag);
  minimap.addEventListener("pointercancel", endMinimapDrag);

  // 画面サイズが変わったとき
  window.addEventListener("resize", () => {
    updateMinimapLayout();
  });

  // 通知
  function showAlert(message) {
    alertMessage.textContent = message;
    alertBox.hidden = false;

    clearTimeout(alertTimer);

    alertBox.classList.remove("fade-out");
    alertBox.classList.add("fade-in");

    alertTimer = setTimeout(() => {
      alertBox.classList.remove("fade-in");
      alertBox.classList.add("fade-out");

      setTimeout(() => {
        alertBox.hidden = true;
      }, 300);
    }, 2000);
  }

  // ローディング
  function setLoading(value) {
    isLoading = value;
    loading.hidden = !value;

    checkButton.disabled = value;
    confirmButton.disabled =
      value || selectedSeats.length !== allowedSeats || selectedSeats.length === 0;
    cancelButton.disabled = value;
  }

  // 座席表示更新
  function updateSeats() {
    allSeats.forEach((seat) => {
      const id = seat.dataset.seatId;

      seat.classList.toggle("selected", selectedSeats.includes(id));
      seat.classList.toggle("mine", mySeats.includes(id));

      seat.disabled =
        !isVerified ||
        mode === "view" ||
        seat.classList.contains("reserved") ||
        seat.classList.contains("camera-seat");

      seat.setAttribute(
        "aria-pressed",
        String(selectedSeats.includes(id))
      );
    });

    selectionInfo.textContent =
      mode === "view"
        ? "現在の予約座席を表示しています"
        : `選択中：${selectedSeats.length} / ${allowedSeats}席`;

    confirmButton.hidden = mode !== "select";
    cancelButton.hidden = mode !== "view";

    confirmButton.disabled =
      isLoading ||
      selectedSeats.length === 0 ||
      selectedSeats.length !== allowedSeats;

    syncMinimapSeats();
  }

  // 予約済み座席の読み込み
  async function loadReservedSeats() {
    try {
      const res = await fetch(`${API_URL}?mode=reservedSeats`);
      const data = await res.json();

      if (!data.success) return;

      allSeats.forEach((seat) => {
        const id = seat.dataset.seatId;

        seat.classList.remove("reserved", "available");

        if (seat.classList.contains("camera-seat")) {
          return;
        }

        if (data.seats.includes(id)) {
          seat.classList.add("reserved");
        } else {
          seat.classList.add("available");
        }
      });

      updateSeats();
    } catch (error) {
      console.error("座席情報の取得に失敗しました", error);
    }
  }

  // 予約ID確認
  async function checkReservation() {
    reservationId = reservationIdInput.value.trim();

    if (!reservationId) {
      showAlert("予約IDを入力してください");
      return;
    }

    setLoading(true);

    try {
      const res = await fetch(
        `${API_URL}?reservation_id=${encodeURIComponent(reservationId)}`
      );

      const data = await res.json();

      if (!data.success) {
        showAlert("予約IDが無効です");
        return;
      }

      allowedSeats = Number(data.people);

      if (!Number.isInteger(allowedSeats) || allowedSeats <= 0) {
        showAlert("予約人数を取得できませんでした");
        return;
      }

      allowedSeatsText.textContent = allowedSeats;

      const status = String(data.status ?? "").trim().toLowerCase();

      if (status === "unused") {
        mode = "select";
        mySeats = [];
        selectedSeats = [];
        isVerified = true;

        reservationLogin.hidden = true;
        content.hidden = false;
        headerInfo.hidden = false;

        await loadReservedSeats();
        updateSeats();
        initializeMinimap();
        return;
      }

      if (status === "reserved") {
        mode = "view";

        const myRes = await fetch(
          `${API_URL}?mode=mySeats&reservation_id=${encodeURIComponent(reservationId)}`
        );

        const myData = await myRes.json();

        if (!myData.success) {
          showAlert("予約席の取得に失敗しました");
          return;
        }

        mySeats =
          typeof myData.seats === "string"
            ? myData.seats.split(",").map((s) => s.trim()).filter(Boolean)
            : myData.seats ?? [];

        selectedSeats = [];
        isVerified = true;

        reservationLogin.hidden = true;
        content.hidden = false;
        headerInfo.hidden = false;

        await loadReservedSeats();

        updateSeats();
        initializeMinimap();
        showAlert("予約済みの座席を表示しました");
        return;
      }

      showAlert("予約IDが無効です");

    } catch (error) {
      console.error(error);
      showAlert("通信に失敗しました");
    } finally {
      setLoading(false);
      updateSeats();
    }
  }

  // 座席クリック
  function toggleSeat(seatId) {
    if (!isVerified || mode === "view" || isLoading) return;

    const seat = allSeats.find(
      (s) => s.dataset.seatId === seatId
    );

    if (!seat || seat.classList.contains("reserved") || seat.classList.contains("camera-seat")) return;

    if (!selectedSeats.includes(seatId) &&
        selectedSeats.length >= allowedSeats) {
      showAlert(`選択できるのは${allowedSeats}席まで`);
      return;
    }

    if (selectedSeats.includes(seatId)) {
      selectedSeats = selectedSeats.filter((id) => id !== seatId);
    } else {
      selectedSeats = [...selectedSeats, seatId];
    }

    updateSeats();
  }

  allSeats.forEach((seat) => {
    seat.addEventListener("click", () => {
      toggleSeat(seat.dataset.seatId);
    });
  });

  // 予約確定
  async function confirmReservation() {
    if (selectedSeats.length === 0) {
      showAlert("座席を選択してください");
      return;
    }

    if (selectedSeats.length !== allowedSeats) {
      showAlert(`${allowedSeats}席選択してください`);
      return;
    }

    const formData = new URLSearchParams();

    formData.append("reservation_id", reservationId);
    formData.append("seats", selectedSeats.join(","));

    setLoading(true);

    try {
      const res = await fetch(API_URL, {
        method: "POST",
        body: formData,
      });

      const data = await res.json();

      if (!data.success) {
        showAlert(data.message ?? "予約に失敗しました");
        return;
      }

      mySeats = [...selectedSeats];
      selectedSeats = [];
      mode = "view";

      await loadReservedSeats();

      updateSeats();
      showAlert("予約完了！");

    } catch (error) {
      console.error(error);
      showAlert("通信に失敗しました");
    } finally {
      setLoading(false);
      updateSeats();
    }
  }

  // 予約取消
  async function cancelReservation() {
    const ok = window.confirm(
      "予約を取り消しますか？この操作は元に戻せません。"
    );

    if (!ok) return;

    setLoading(true);

    try {
      const formData = new URLSearchParams();

      formData.append("mode", "cancel");
      formData.append("reservation_id", reservationId);

      const res = await fetch(API_URL, {
        method: "POST",
        body: formData,
      });

      const data = await res.json();

      if (!data.success) {
        showAlert(data.message ?? "取消に失敗しました");
        return;
      }

      mySeats = [];
      selectedSeats = [];
      mode = "select";

      await loadReservedSeats();

      updateSeats();
      showAlert("予約を取り消しました");

    } catch (error) {
      console.error(error);
      showAlert("通信に失敗しました");
    } finally {
      setLoading(false);
      updateSeats();
    }
  }

  function syncMinimapSeats() {
    const miniSeats = minimapContent.querySelectorAll(
      ".seat"
    );

    miniSeats.forEach((miniSeat) => {
      const seatId = miniSeat.dataset.seatId;

      const originalSeat = allSeats.find(
        (seat) => seat.dataset.seatId === seatId
      );

      if (!originalSeat) return;

      miniSeat.className = originalSeat.className;
    });
  }

  checkButton.addEventListener("click", checkReservation);

  reservationIdInput.addEventListener("keydown", (event) => {
    if (event.key === "Enter") checkReservation();
  });

  confirmButton.addEventListener("click", confirmReservation);
  cancelButton.addEventListener("click", cancelReservation);

  // 初期表示
  loadReservedSeats();
</script>