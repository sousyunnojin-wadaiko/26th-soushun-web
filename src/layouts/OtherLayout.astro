---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageButton from "../components/items/pageButton.astro";
import "../../styles/global.css";

interface Props {
  title?: string;
  pageTitle?: string;
  bg?: "night" | "storm" | "flower" | "wind" ;
  title_icon_posi?: "left" | "center" | "right";
  title_icon_offset?: number;
}

const {
  title = "第26回 和太鼓 早春の陣",
  pageTitle = "",
  bg = "wind",
  title_icon_posi = "right",
  title_icon_offset = 10,
} = Astro.props;

const titleIconStyle =
  title_icon_posi === "left"
    ? `left: ${title_icon_offset}px;`
    : title_icon_posi === "right"
      ? `right: ${title_icon_offset}px;`
      : "left: 50%; transform: translate(-50%, -50%);";

const iconSrc = `/icon/icon_${bg}.svg`;
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Hina+Mincho&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={`bg-${bg}`}>
    <Header />

    <main class="other-page">
      {pageTitle && (
        <div class="title-wrapper">
          <img
            src={iconSrc}
            alt=""
            aria-hidden="true"
            class="title-icon"
            style={titleIconStyle}
          />
          <h1 class="page-title">{pageTitle}</h1>
        </div>
      )}

      <slot />
    </main>
    <PageButton
      href="/"
      background={iconSrc}
      label="トップページ"
      position={title_icon_posi}
    />

    <Footer />
  </body>
</html>

<style>
  :global(body) {
    overflow-x: clip;
  }

  /* 宵 */
  :global(body.bg-night) {
    background: linear-gradient(
      180deg,
      #0C1020 0%,
      #292744 40%,
      #805A68 70%,
      #BA816D 100%
    );
  }

  /* 嵐 */
  :global(body.bg-storm) {
    background: linear-gradient(
      180deg,
      #111D22 0%,
      #035266 40%,
      #0a90a8 70%,
      #615f4d 100%
    );
  }

  /* 花 */
  :global(body.bg-flower) {
    background: linear-gradient(
      180deg,
      #301B29 0%,
      #803D53 40%,
      #C97980 70%,
      #E7B9A0 100%
    );
  }

  /* 風 */
  :global(body.bg-wind) {
    background: linear-gradient(
      180deg,
      #142921 0%,
      #095236 40%,
      #2bb65c 70%,
      #bfffb7 100%
    );
  }

  .other-page {
    padding: 100px 0;
  }

  @media (max-width: 768px) {
    .other-page {
      padding: 50px 0;
    }
  }

  /* ===== ページタイトル ===== */

  .title-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;

    width: fit-content;
    min-width: 300px;
    margin: 60px auto;
  }

  .title-icon {
    position: absolute;
    width: 100px;
    height: auto;

    top: 50%;
    transform: translateY(-50%);

    pointer-events: none;
  }

  .page-title {
    position: relative;
    z-index: 1;

    margin: 0;
    padding: 10px 60px;

    color: #EEEFF6;
    font-family: "Hina Mincho", serif;
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 400;
    letter-spacing: 0.15em;
  }
</style>
