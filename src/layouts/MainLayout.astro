---
import "../../styles/global.css";

interface Props {
  title?: string;
}

const { title = "第26回 和太鼓 早春の陣" } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body class="overflow-x-hidden">
    <slot />
  </body>
</html>
