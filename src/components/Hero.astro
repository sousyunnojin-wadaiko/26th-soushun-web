---
const heroImage = "/poster_model.webp";

const ICE_CONFIG = {
  count: 200,
  centerX: 50,
  centerY: 53,
  minRadius: 5,
  maxRadius: 30,
  spreadX: 1.0,
  spreadY: 1.4,
  redRatio: 0.15,
};

const random = (n: number) => {
  const x = Math.sin(n * 127.1 + 78.233) * 43758.5453;
  return x - Math.floor(x);
};

const shards = Array.from(
  { length: ICE_CONFIG.count },
  (_, i) => {
    const r = (offset: number) => random(i * 9 + offset);

    const angle = r(1) * Math.PI * 2;
    const radius = Math.sqrt(r(2));

    const distance =
      ICE_CONFIG.minRadius +
      radius * (ICE_CONFIG.maxRadius - ICE_CONFIG.minRadius);

    const size = 4 + (1 - radius) * 18 + r(3) * 7;

    return {
      x:
        ICE_CONFIG.centerX +
        Math.cos(angle) * distance * ICE_CONFIG.spreadX,

      y:
        ICE_CONFIG.centerY +
        Math.sin(angle) * distance * ICE_CONFIG.spreadY,

      width: size * (0.5 + r(4)),
      height: size * (0.8 + r(5) * 1.5),
      rotation: r(6) * 360,
      opacity: 0.25 + r(7) * 0.65,
      shape: i % 3,
      color: r(8) < ICE_CONFIG.redRatio ? "red" : "blue",
    };
  }
);
---

<section class="hero">

  <div class="hero__ice" aria-hidden="true">
    <div class="hero__glow"></div>

    {shards.map((shard) => (
      <div
        class={`ice-shard ice-shard--${shard.shape} ice-shard--${shard.color}`}
        style={`
          left: ${shard.x}%;
          top: ${shard.y}%;
          --shard-width: ${shard.width}px;
          --shard-height: ${shard.height}px;
          transform: translate(-50%, -50%) rotate(${shard.rotation}deg);
          opacity: ${shard.opacity};
        `}
      />
    ))}
  </div>
  
  <!-- Hero Image -->
  <img
    src={heroImage}
    alt=""
    class="hero__image"
  />

  <!-- Clouds -->
  <img class="cloud_1" src="/icon/icon_cloud1.svg" alt="" aria-hidden="true"/>
  <img class="cloud_2" src="/icon/icon_cloud2.svg" alt="" aria-hidden="true"/>
  <img class="cloud_3" src="/icon/icon_cloud3.svg" alt="" aria-hidden="true"/>
  <img class="cloud_4" src="/icon/icon_cloud4.svg" alt="" aria-hidden="true"/>

  <!-- event name -->
  <div class="hero__event-name vertical-text">
    <h3>第二十六回 和太鼓 早春の陣</h3>
  </div>

  <div class="hero__main-title vertical-text">
    <h1 class="title-text title-text--main">
      <ruby>解<rt>ほどき</rt></ruby>
    </h1>
  </div>

  <div class="hero__subtitle vertical-text">
    <p class="title-text title-text--sub">
      <span class="vertical-wave">〜</span>
      春呼びの<ruby>音<rt>ね</rt></ruby>
      <span class="vertical-wave">〜</span>
    </p>
  </div>

  <div class="hero__info vertical-text">
    <h3>二〇二七年二月二八日（日）午後一時開演</h3>
    <h3>アオーレ長岡 市民交流ホールA</h3>
  </div>
  
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    max-width: none;
    height: 100vh;
    height: 100svh;
    margin: 0;
    padding: 0;
    overflow: hidden;
    isolation: isolate;

    --hero-image-height: 130%;
    --main-title-size: clamp(10rem, 14vw, 14rem);
    --sub-title-size: clamp(2rem, 3vw, 2.5rem);
    --info-size: clamp(1.1rem, 2vw, 1.2rem);

    background: linear-gradient(
      to bottom,
      #0e0f0f 0%,
      #1e2024 30%,
      #393c42 100%
    );
  }

  .hero__image {
    position: absolute;
    z-index: 10;
    left: 50%;
    top: 0;
    height: var(--hero-image-height);
    width: auto;
    max-width: none;
    transform: translateX(-50%);
    filter: grayscale(20%) brightness(95%);
  }

  .hero__ice {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .hero__glow {
    position: absolute;

    left: 50%;
    top: 53%;
    width: 75%;
    height: 85%;

    transform: translate(-50%, -50%);

    background: radial-gradient(
      ellipse,
      rgba(180, 215, 255, 0.18) 0%,
      rgba(120, 170, 230, 0.06) 40%,
      transparent 75%
    );

    filter: blur(30px);
  }

  .ice-shard {
    position: absolute;
    width: var(--shard-width);
    height: var(--shard-height);

    filter: drop-shadow(
      0 0 5px rgba(200, 230, 255, 0.5)
    );
  }

  .ice-shard--blue {
    background: linear-gradient(
      125deg,
      rgba(255, 255, 255, 0.9) 0%,
      rgba(148, 205, 255, 0.15) 35%,
      rgba(255, 255, 255, 0.04) 55%,
      rgba(213, 237, 255, 0.75) 100%
    );
  }

  .ice-shard--red {
    background: linear-gradient(
      125deg,
      rgba(255, 225, 205, 0.95) 0%,
      rgba(220, 105, 75, 0.45) 35%,
      rgba(255, 180, 125, 0.12) 55%,
      rgba(195, 65, 50, 0.8) 100%
    );

    filter: drop-shadow(
      0 0 6px rgba(220, 90, 60, 0.45)
    );
  }

  .ice-shard--0 {
    clip-path: polygon(
      50% 0%,
      100% 35%,
      72% 100%,
      15% 80%,
      0% 22%
    );
  }

  .ice-shard--1 {
    clip-path: polygon(
      45% 0%,
      85% 15%,
      60% 100%,
      10% 75%
    );
  }

  .ice-shard--2 {
    clip-path: polygon(
      50% 0%,
      100% 100%,
      0% 75%
    );
  }

  .vertical-text {
    position: absolute;
    writing-mode: vertical-rl;
    text-orientation: upright;
    isolation: isolate;
  }

  .vertical-text::before {
    content: "";
    position: absolute;
    inset: -30px;
    z-index: -1;

    background: radial-gradient(
      ellipse,
      rgba(0, 0, 0, 0.65) 0%,
      rgba(0, 0, 0, 0.3) 50%,
      transparent 85%
    );

    filter: blur(25px);
    pointer-events: none;
  }

  /* Title Common Style */
  .title-text {
    background: linear-gradient(
      to bottom,
      #ffe08a 0%,   /* 黄色 */
      #ffb347 30%,  /* オレンジ */
      #ff8716 60%,  /* 濃いオレンジ */
      #c83220 100%  /* 赤 */
    );

    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;

    margin: 0;
  }

  .title-text rt {
    font-weight: normal;
  }

  /* Main Title */
  .title-text--main {
    font-size: var(--main-title-size);
  }

  .title-text--main rt {
    font-size: 0.3em;
  }

  /* Subtitle */
  .title-text--sub {
    font-size: var(--sub-title-size);
  }

  .title-text--sub rt {
    font-size: 0.35em;
  }

  .vertical-wave {
    display: inline-block;
    transform: rotate(90deg);

    background: linear-gradient(
      to right,
      #ffe08a 0%,
      #ffb347 30%,
      #ff8716 60%,
      #c83220 100%
    );

    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero__event-name {
    right: 15%;
    top: 8%;
    z-index: 20;
  }

  .hero__event-name,
  .hero__info {
    font-size: var(--info-size);
  }

  .hero__event-name h3,
  .hero__info h3 {
    font-size: inherit;
  }

  .hero__main-title {
    right: 25%;
    top: 8%;
    z-index: 5;
  }

  .hero__subtitle {
    left: 23%;
    top: 40%;
    z-index: 5;
  }

  .hero__info {
    left: 15%;
    bottom: 8%;
    z-index: 20;
  }

@media (min-width: 769px) and (max-width: 1024px) {
  .hero {
    --hero-image-height: 115%;
    --main-title-size: clamp(7rem, 16vw, 10rem);
    --sub-title-size: clamp(2rem, 4vw, 2.3rem);
    --info-size: clamp(1rem, 2vw, 1.1rem);
  }

  .hero__image {
    top: 10%;
    -webkit-mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 60%,
      transparent 80%
    );

    mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 60%,
      transparent 80%
    );
  }

  .hero__event-name {
    right: 8%;
    top: 10%;
  }

  .hero__main-title {
    right: 20%;
    top: 12%;
  }

  .hero__subtitle {
    left: 15%;
    top: 48%;
  }

  .hero__info {
    left: 8%;
    bottom: 8%;
  }
}

/* ========================================
   Mobile (max-width: 768px)
======================================== */
@media (max-width: 768px) {
  .hero {
    --hero-image-height: 85%;
    --main-title-size: clamp(5rem, 20vw, 7rem);
    --sub-title-size: clamp(1.3rem, 6vw, 2rem);
    --info-size: clamp(1rem, 3vw, 1.2rem);
  }

  .ice-shard {
    width: calc(var(--shard-width) * 0.65);
    height: calc(var(--shard-height) * 0.65);
  }

  .hero__ice {
    transform: translateX(-5%);
  }

  /* 人物画像 */
  .hero__image {
    left: 45%;
    top: 30%;
    -webkit-mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 60%,
      transparent 80%
    );

    mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 60%,
      transparent 80%
    );
  }

  .hero__event-name {
    right: 5%;
    top: 10%;
    z-index: 20;
  }

  .hero__main-title {
    right: 15%;
    top: 15%;
    z-index: 5;
  }

  .hero__subtitle {
    right: 18%;
    top: clamp(35%, 40vw, 45%);
    z-index: 5;
  }

  .hero__info {
    left: 5%;
    bottom: 5%;
    z-index: 20;
  }

  .vertical-text::before {
    inset: -15px;
    filter: blur(15px);
  }
}

.cloud_1, .cloud_2, .cloud_3, .cloud_4 {
  position: absolute;
  z-index: 0;
  height: auto;
  opacity: 0.3;
}

.cloud_1 {
  right: 15%;
  bottom: 20%;
  width: 6%;
}

.cloud_2 {
  left: 25%;
  top: 33%;
  width: 5%;
}

.cloud_3 {
  right: 20%;
  bottom: 10%;
  width: 15%;
}

.cloud_4 {
  left: 30%;
  top: 20%;
  width: 13%;
}

@media (max-width: 768px) {
  .cloud_1 {
    right: 30%;
    bottom: 3%;
    width: 10%;
  }

  .cloud_2 {
    left: auto;
    top: auto;
    right: 20%;
    bottom: 5%;
    width: 10%;
  }

  .cloud_3 {
    right: 3%;
    bottom: 10%;
    width: 30%;
  }

  .cloud_4 {
    left: 8%;
    top: 30%;
    width: 30%;
  }
}
</style>